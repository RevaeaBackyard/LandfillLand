---
import 'lite-youtube-embed/src/lite-yt-embed.css'
---

<script>
type MermaidApi = (typeof import('mermaid'))['default']

let mermaidObserver: IntersectionObserver | null = null
let mermaidModulePromise: Promise<MermaidApi> | null = null
let mermaidRenderQueue: Promise<void> = Promise.resolve()

function loadMermaid(): Promise<MermaidApi> {
  if (!mermaidModulePromise) {
    mermaidModulePromise = import('mermaid')
      .then(({ default: mermaid }) => mermaid)
      .catch((error) => {
        mermaidModulePromise = null
        throw error
      })
  }

  return mermaidModulePromise
}

async function renderMermaidNodes(nodes: HTMLElement[]) {
  let connectedNodes = nodes.filter(node => node.isConnected)
  if (connectedNodes.length === 0) {
    return
  }

  const mermaid = await loadMermaid()
  connectedNodes = connectedNodes.filter(node => node.isConnected)
  if (connectedNodes.length === 0) {
    return
  }

  mermaid.initialize({
    startOnLoad: false,
    theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
  })
  await mermaid.run({ nodes: connectedNodes })
}

function queueMermaidRender(nodes: HTMLElement[]) {
  mermaidRenderQueue = mermaidRenderQueue
    .then(() => renderMermaidNodes(nodes))
    .catch((error) => {
      console.error('[MediaEmbed] Failed to render Mermaid:', error)
    })
}

function setupMermaidEmbeds() {
  mermaidObserver?.disconnect()
  mermaidObserver = null

  const mermaids = Array.from(document.querySelectorAll<HTMLElement>('pre.mermaid'))
  if (mermaids.length === 0) {
    return
  }

  mermaids.forEach((mermaid) => {
    if (!mermaid.dataset.mermaidCode) {
      mermaid.dataset.mermaidCode = mermaid.textContent?.trim() ?? ''
    }
  })

  const pendingMermaids = mermaids.filter(mermaid => !mermaid.hasAttribute('data-processed'))
  if (pendingMermaids.length === 0) {
    return
  }

  if (!('IntersectionObserver' in window)) {
    queueMermaidRender(pendingMermaids)
    return
  }

  const observer = new IntersectionObserver((entries) => {
    const visibleMermaids = entries
      .filter(entry => entry.isIntersecting)
      .map(entry => entry.target as HTMLElement)

    visibleMermaids.forEach(mermaid => observer.unobserve(mermaid))
    if (visibleMermaids.length > 0) {
      queueMermaidRender(visibleMermaids)
    }
  }, { rootMargin: '300px' })

  mermaidObserver = observer
  pendingMermaids.forEach(mermaid => observer.observe(mermaid))
}

// Load YouTube embed script
async function setupYouTubeEmbeds() {
  const youtube = document.querySelectorAll('lite-youtube')
  if (youtube.length === 0) {
    return
  }

  try {
    // @ts-expect-error - No type definitions available for lite-youtube-embed
    await import('lite-youtube-embed')
  }
  catch (error) {
    console.error('[MediaEmbed] Failed to load YouTube embed:', error)
  }
}

// Initialize Twitter widgets
async function setupTweetEmbeds() {
  const tweets = document.querySelectorAll('.twitter-tweet')
  if (tweets.length === 0) {
    return
  }

  tweets.forEach((tweet) => {
    tweet.setAttribute('data-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light')
  })

  // Inject Twitter script
  const script = document.createElement('script')
  script.src = 'https://platform.twitter.com/widgets.js'
  script.async = true
  document.head.appendChild(script)
}

// Initialize all media embeds
async function setupMediaEmbeds() {
  setupMermaidEmbeds()

  await Promise.allSettled([
    setupYouTubeEmbeds(),
    setupTweetEmbeds(),
  ])
}

// Re-render Mermaid diagrams on theme change
function updateMermaidTheme() {
  const mermaids = Array.from(
    document.querySelectorAll<HTMLElement>('pre.mermaid[data-mermaid-code][data-processed]'),
  )
  if (mermaids.length === 0) {
    return
  }

  mermaids.forEach((mermaid) => {
    mermaid.innerHTML = mermaid.dataset.mermaidCode ?? ''
    mermaid.removeAttribute('data-processed')
  })

  queueMermaidRender(mermaids)
}

function cleanupMermaidEmbeds() {
  mermaidObserver?.disconnect()
  mermaidObserver = null
}

// Handle horizontal scrolling for gallery
function handleGalleryWheel(e: WheelEvent) {
  const container = (e.target as Element)?.closest('.gallery-container') as HTMLElement
  if (!container) {
    return
  }

  // Convert vertical scroll to horizontal
  const previousScrollLeft = container.scrollLeft
  container.scrollLeft += e.deltaY
  if (container.scrollLeft === previousScrollLeft) {
    return
  }

  // Prevent default scroll only if horizontal scroll occurred
  e.preventDefault()
}

document.addEventListener('astro:page-load', setupMediaEmbeds)
document.addEventListener('astro:before-swap', cleanupMermaidEmbeds)
document.addEventListener('theme-changed', updateMermaidTheme)
document.addEventListener('wheel', handleGalleryWheel, { passive: false })
</script>
